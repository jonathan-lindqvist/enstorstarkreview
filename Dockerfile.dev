# Dev image for docker-compose.dev.yml. Production builds from ./Dockerfile.
#
# Separate file rather than a stage in Dockerfile: without BuildKit, --target still
# runs every preceding stage.

FROM node:22-bookworm-slim

WORKDIR /app

# The node_modules volume is seeded from this image, so it has to be node-owned. Installing
# as node avoids a recursive chown, which copies every dependency file into a new layer.
RUN chown node:node /app
USER node

# Record the same fingerprint used at startup, including native install scripts.
COPY --chown=node:node package.json package-lock.json .npmrc ./
COPY --chown=node:node scripts/dev/sync-dependencies.js ./scripts/dev/sync-dependencies.js
RUN node scripts/dev/sync-dependencies.js
COPY scripts/dev/entrypoint.sh /usr/local/bin/dev-entrypoint

EXPOSE 5173

ENTRYPOINT ["sh", "/usr/local/bin/dev-entrypoint"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
