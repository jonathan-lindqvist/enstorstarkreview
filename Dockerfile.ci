# Image for `make ci` (docker-compose.ci.yml): the GitHub CI checks without a local toolchain.
#
# Same Node base as production (Dockerfile) and development (Dockerfile.dev). Chromium and
# its system libraries come from the locked Playwright version, so nothing here needs
# bumping when Playwright changes. Runs as root: the container is disposable and its report
# bind mounts must be writable whatever the host user's uid is.

FROM node:22-bookworm-slim

# python3 runs the deployment tests; shellcheck validates the shell scripts.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 shellcheck \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Must run before the project .npmrc (ignore-scripts=true) is in place, or the native
# modules argon2 and sharp skip their build step.
COPY package.json package-lock.json ./
RUN npm config set ignore-scripts false \
	&& npm ci \
	&& npx playwright install --with-deps chromium \
	&& rm -rf /var/lib/apt/lists/*

# A snapshot of the working tree, so the run cannot touch the host's .svelte-kit or
# node_modules (the dev server shares those through its bind mount).
COPY . .

CMD ["bash", "scripts/ci/run-all.sh"]
