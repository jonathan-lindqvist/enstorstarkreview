# CI image for docker-compose.ci.yml. `make check` and `make ci` run scripts/ci/run.js in it.

FROM docker:28.5.2-cli AS docker-cli

FROM node:22-bookworm-slim

# git copies the checkout, python3 runs the deployment tests, and shellcheck checks the
# restricted SSH command.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates git python3 shellcheck \
	&& rm -rf /var/lib/apt/lists/*

# The backup/restore rehearsal drives the host's Docker daemon. Deployment commands run with a
# fixed PATH, so the CLI has to be in /usr/bin.
COPY --from=docker-cli /usr/local/bin/docker /usr/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/libexec/docker/cli-plugins

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Installs the locked Playwright browser and leaves a warm npm cache for each run's `npm ci`.
WORKDIR /opt/ci-dependencies
COPY package.json package-lock.json .npmrc ./
RUN npm ci --ignore-scripts=false \
	&& npx playwright install --with-deps chromium \
	&& rm -rf node_modules /var/lib/apt/lists/*

WORKDIR /work
