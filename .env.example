# Copy this file to .env and set strong credentials before docker compose up.
# Do not commit .env.

MONGO_ROOT_USERNAME=change_me_root
MONGO_ROOT_PASSWORD=change_me_long_random_password
APP_MONGO_URI=mongodb://change_me_root:change_me_long_random_password@mongo:27017/enstorstark?authSource=admin
# Optional. Leave unset in Docker to use the mounted uploads path: /app/uploads/images.
# REVIEW_IMAGE_DIR=/app/uploads/images
