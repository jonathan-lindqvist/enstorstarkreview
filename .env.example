# Copy this file to .env and set strong credentials before docker compose up.
# Do not commit .env.

MONGO_ROOT_USERNAME=change_me_root
MONGO_ROOT_PASSWORD=change_me_long_random_password
APP_MONGO_URI=mongodb://change_me_root:change_me_long_random_password@mongo:27017/enstorstark?authSource=admin
# Required in production; optional in development, where unset uses the local sink.
REVIEW_REQUEST_DISCORD_WEBHOOK_URL=
# Optional. Leave unset in Docker to use the mounted uploads path: /app/uploads/images.
# REVIEW_IMAGE_DIR=/app/uploads/images
# Optional push notifications about new reviews; each platform stays off without its values.
# APNs auth key (.p8) from Apple Developer: key ID, team ID, and the key on one line with \n.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# Firebase service-account key JSON (on one line) with permission to send FCM messages.
# FCM_SERVICE_ACCOUNT_JSON=
