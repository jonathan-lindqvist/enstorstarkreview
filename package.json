{
	"name": "enstorstarkreview",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"api:generate": "UPDATE_OPENAPI=1 vitest run src/lib/server/api/openapi.test.ts && node scripts/generate-api-types.js",
		"api:types": "node scripts/generate-api-types.js",
		"api:lint": "redocly lint openapi/v1.yaml",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:update": "vitest run --coverage --coverage.thresholds.autoUpdate=true && prettier --write vite.config.ts",
		"test:ci": "node --test db/*.test.js scripts/ci/*.test.js && python3 -m unittest discover -s scripts/deploy -p test_deploy.py -v && python3 -m unittest discover -s mobile/scripts -p 'test_*.py' -v",
		"test:deploy:restore": "DEPLOY_TEST_DOCKER=1 python3 -m unittest discover -s scripts/deploy -p test_backup_restore.py -v",
		"create-user": "node scripts/create-user.js",
		"seed-bars": "node scripts/seed-bars.js",
		"db:build": "make -C db build",
		"db:run": "make -C db run",
		"db:prepare": "make -C db prepare",
		"db:all": "make -C db all",
		"db:clean": "make -C db clean",
		"db:reset": "make -C db reset"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "5.2.5",
		"@lucia-auth/adapter-mongodb": "1.0.3",
		"@lucide/svelte": "1.25.0",
		"@neoconfetti/svelte": "2.2.2",
		"@playwright/test": "1.57.0",
		"@redocly/cli": "2.54.3",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tailwindcss/vite": "4.3.1",
		"@types/eslint": "9.6.1",
		"@types/markdown-it": "14.1.2",
		"@types/node": "22.15.21",
		"@vitest/coverage-v8": "4.1.12",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"eslint": "9.39.5",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "15.15.0",
		"lucia": "3.2.2",
		"mongodb": "6.15.0",
		"openapi-typescript": "7.13.0",
		"postcss": "8.5.29",
		"prettier": "3.5.3",
		"prettier-plugin-svelte": "3.3.3",
		"sass": "1.86.0",
		"svelte": "5.55.7",
		"svelte-check": "4.1.5",
		"tailwindcss": "4.3.1",
		"typescript": "5.8.2",
		"typescript-eslint": "8.55.0",
		"vite": "8.1.6",
		"vitest": "4.1.12",
		"yaml": "2.9.0"
	},
	"dependencies": {
		"argon2": "0.41.1",
		"effect": "4.0.6",
		"maplibre-gl": "6.4.1",
		"markdown-it": "14.3.3",
		"sharp": "0.35.5"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		},
		"@maplibre/maplibre-gl-style-spec": {
			"@mapbox/jsonlint-lines-primitives": "2.0.2"
		},
		"@rolldown/binding-wasm32-wasi": {
			"@napi-rs/wasm-runtime": "1.1.6"
		}
	},
	"type": "module"
}
