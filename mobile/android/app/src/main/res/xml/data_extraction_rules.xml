<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone, also not in a device-to-device transfer, which ignores
     allowBackup="false" from Android 12. The session must be signed in again, and an unsaved
     review stays with its reviewer's phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
