// The Swift module of the app's code is EnStorStark (see ../Package.swift).
PRODUCT_NAME = EnStorStark
PRODUCT_BUNDLE_IDENTIFIER = se.enstorstarkreview.app

// The release task sets the version to the release date (2026.10.25) and the build number to the
// commit count (see ../README.md#releases). Local builds use these placeholders.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

INFOPLIST_FILE = Info.plist
// Debug adds an ATS exception for HTTP to the local dev server (make dev)
INFOPLIST_FILE[config=Debug] = Info-Debug.plist
GENERATE_INFOPLIST_FILE = YES

// The user-visible name of the app (localizable)
INFOPLIST_KEY_CFBundleDisplayName = En Stor Stark
//INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities

// Photos for reviews: the camera asks for access. The library picker (PhotosPicker) needs none.
INFOPLIST_KEY_NSCameraUsageDescription = Ta ett foto på baren till recensionen.

// Location is only shown on the map. It is never sent to the server.

INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Din position används bara i appen, för kartan och för att sortera barerna efter avstånd. Den sparas inte och skickas inte till vår server.

// iOS-specific Info.plist property keys
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphone*] = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphone*] = YES
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphone*] = YES
INFOPLIST_KEY_UIStatusBarStyle[sdk=iphone*] = UIStatusBarStyleDefault
INFOPLIST_KEY_UISupportedInterfaceOrientations[sdk=iphone*] = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

IPHONEOS_DEPLOYMENT_TARGET = 26.0
SUPPORTS_MACCATALYST = NO

SUPPORTED_PLATFORMS = iphoneos iphonesimulator

// iPhone + iPad
TARGETED_DEVICE_FAMILY = 1,2

// iPhone only
// TARGETED_DEVICE_FAMILY = 1

// the name of the product module; this can be anything, but cannot conflict with any Swift module names
PRODUCT_MODULE_NAME = $(PRODUCT_NAME:c99extidentifier)App

// On-device testing may need to override the bundle ID
// PRODUCT_BUNDLE_IDENTIFIER[config=Debug][sdk=iphoneos*] = cool.beans.BundleIdentifer

SDKROOT = auto

SWIFT_VERSION = 6

// Signing for devices, TestFlight, and the App Store (personal team of Elias Carlson).
// Xcode manages the certificates and profiles. Simulator builds need no signing.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Entitlements.plist
DEVELOPMENT_TEAM = FF8JDK3FMJ
