# Normalize line endings to LF on checkout for all text files
* text=auto eol=lf

# Explicitly declare text files
*.ts text eol=lf
*.svelte text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Shell scripts must have LF (they break with CRLF)
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.lock binary
